# 复制为同目录的 .env 后填写。.env 已被 .gitignore 排除，不要提交，也不要贴到聊天里。

# ---- 主流程必需 ----
# LLM：DeepSeek V4.1 Flash，经 LiteLLM 网关（infra/litellm.yaml 的 deepseek-flash 模型组）
DEEPSEEK_API_KEY=
# 网关的访问口令，自己生成一个随机串；Coze 注册模型、sidecar 调网关都用它
LITELLM_MASTER_KEY=
# Coze 工作流调 sidecar 时带的口令（X-Sidecar-Token），自己生成一个随机串
SIDECAR_TOKEN=
# 高德 Web 服务 key：地理编码、路线、门店 ETL
AMAP_WEB_SERVICE_KEY=
# 博查搜索 key：看榜单时实时搜网页（约 0.036 元/次，sidecar 按天缓存）
BOCHA_API_KEY=
# Coze OpenAPI 的个人访问令牌：留空即可，第一次运行 bridge/chat_api.py 会自动创建并写到这里（30 天有效）
COZE_PAT=

# ---- 网页 Demo ----
# 高德 Web 端（JS API 2.0）key 和安全密钥，显示地图
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

# ---- 可选：换模型 ----
# 网关里还配了 Claude 和豆包（火山方舟），用到才填
ANTHROPIC_API_KEY=
ARK_API_KEY=
OPENROUTER_API_KEY=

# ---- 可选：早期数据渠道（现在的主流程不用） ----
# 豆包搜索、百度千帆搜索：发现小红书、抖音笔记的候选入口
DOUBAO_SEARCH_API_KEY=
BAIDU_QIANFAN_API_KEY=
# 聚推客（抖音团购，2025-06 已下线）、TypeSafe（Jev 决策模型，暂不用）、百度地图、抖音开放平台
JUTUIKE_API_KEY=
TYPESAFE_API_KEY=
BAIDU_MAP_AK=
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
