# 复制为同目录的 .env 后填写。.env 已被 .gitignore 排除，不要提交，也不要贴到聊天里。

# ---- 现在就需要 ----
# 高德 Web 服务 key（建库 ETL、自定义插件 amap_poi）
# 同一个 key 还要填进 coze-studio/backend/conf/plugin/pluginproduct/plugin_meta.yaml 里高德插件的 service_token
AMAP_WEB_SERVICE_KEY=

# 豆包搜索 Custom 版，按量后付费的 API Key（发现小红书、点评探店笔记、抖音 shipin 页）
DOUBAO_SEARCH_API_KEY=

# 聚推客 apikey（抖音团购商品搜索）
JUTUIKE_API_KEY=

# 接 Claude，二选一
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ---- M4 需要 ----
# 博查搜索 key，填进 plugin_meta.yaml 里博查插件的 service_token；这里留一份给 ETL 用
BOCHA_API_KEY=

# 百度千帆搜索 API Key（bce-v3/ 开头），候选发现源：小红书笔记、抖音 shipin 页
BAIDU_QIANFAN_API_KEY=

# ---- M7 需要 ----
# 高德 Web 端（JS API）key 和安全密钥，网页 Demo 显示地图
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

# ---- 可选 ----
TYPESAFE_API_KEY=
ARK_API_KEY=
BAIDU_MAP_AK=
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
