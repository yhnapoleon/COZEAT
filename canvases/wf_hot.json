], "sql": "SELECT name, cate, biz_area, address, rating, cost, note_cnt, tags FROM shop WHERE note_cnt > 0 ORDER BY note_cnt DESC, rating DESC LIMIT 40"}, "outputs": [{"type": "list", "name": "outputList", "schema": {"type": "object", "schema": [{"name": "name", "type": "string", "required": false}, {"name": "cate", "type": "string", "required": false}, {"name": "biz_area", "type": "string", "required": false}, {"name": "address", "type": "string", "required": false}, {"name": "rating", "type": "string", "required": false}, {"name": "cost", "type": "string", "required": false}, {"name": "note_cnt", "type": "string", "required": false}, {"name": "tags", "type": "string", "required": false}]}}, {"name": "rowNum", "type": "integer", "required": false}]}}, {"id": "200028", "type": "5", "meta": {"position": {"x": 600, "y": 0}}, "data": {"nodeMeta": {"title": "整理榜单输入", "subTitle": "代码", "mainColor": "#00B2B2"}, "inputs": {"inputParameters": [{"name": "body", "input": {"type": "string", "value": {"content": {"blockID": "200026", "name": "body", "source": "block-output"}, "rawMeta": {"type": 1}, "type": "ref"}}}, {"name": "rows", "input": {"type": "list", "value": {"content": {"blockID": "200027", "name": "outputList", "source": "block-output"}, "rawMeta": {"type": 103}, "type": "ref"}, "schema": {"type": "object", "schema": [{"name": "name", "type": "string", "required": false}, {"name": "cate", "type": "string", "required": false}, {"name": "biz_area", "type": "string", "required": false}, {"name": "address", "type": "string", "required": false}, {"name": "rating", "type": "string", "required": false}, {"name": "cost", "type": "string", "required": false}, {"name": "note_cnt", "type": "string", "required": false}, {"name": "tags", "type": "string", "required": false}]}}}], "code": "\nimport json\nasync def main(args: Args) -> Output:\n    p = args.params\n    try:\n        d = json.loads(p.get(\"body\") or \"{}\")\n    except Exception:\n        d = {}\n    NL = chr(10)\n    web = [str(i + 1) + \". \" + str(x.get(\"title\") or \"\") + \"｜\" + str(x.get(\"site\") or \"\") + \"｜\" + str(x.get(\"date\") or \"\") + NL\n           + \"   \" + str(x.get(\"text\") or \"\")[:300] + NL + \"   \" + str(x.get(\"url\") or \"\")\n           for i, x in enumerate(d.get(\"items\") or [])]\n    # 高德的商圈字段很粗（万象城的店也标\"后海片区\"），带上地址让模型按商场名筛\n    local = [str(r.get(\"name\")) + \"｜\" + str(r.get(\"address\") or \"\")[:30] + \"｜\" + str(r.get(\"cate\") or \"\").split(\"/\")[-1] + \"｜评分 \" + str(r.get(\"rating\")) + \"｜人均 \"\n             + str(r.get(\"cost\")) + \"｜小红书笔记 \" + str(r.get(\"note_cnt\")) + \" 篇\" for r in p.get(\"rows\") or []]\n    return {\"web\": NL.join(web) or \"（搜索没有结果\" + (\"：\" + str(d.get(\"error\")) if d.get(\"error\") else \"\") + \"）\",\n            \"local\": NL.join(local) or \"（无）\"}\n", "language": 3, "settingOnError": {"processType": 1, "retryTimes": 0, "timeoutMs": 60000}}, "outputs": [{"name": "web", "type": "string", "required": false}, {"name": "local", "type": "string", "required": false}]}}, {"id": "200029", "type": "3", "meta": {"position": {"x": 900, "y": 0}}, "data": {"nodeMeta": {"title": "榜单回答", "subTitle": "大模型", "mainColor": "#5C62FF"}, "inputs": {"inputParameters": [{"name": "query", "input": {"type": "string", "value": {"content": {"blockID": "100001", "name": "query", "source": "block-output"}, "rawMeta": {"type": 1}, "type": "ref"}}}, {"name": "web", "input": {"type": "string", "value": {"content": {"blockID": "200028", "name": "web", "source": "block-output"}, "rawMeta": {"type": 1}, "type": "ref"}}}, {"name": "local", "input": {"type": "string", "value": {"content": {"blockID": "200028", "name": "local", "source": "block-output"}, "rawMeta": {"type": 1}, "type": "ref"}}}], "llmParam": [{"name": "modelType", "input": {"type": "integer", "value": {"content": "100003", "rawMeta": {"type": 2}, "type": "literal"}}}, {"name": "modleName", "input": {"type": "string", "value": {"content": "DeepSeek V4.1 Flash（经 LiteLLM 网关）", "rawMeta": {"type": 1}, "type": "literal"}}}, {"name": "generationDiversity", "input": {"type": "string", "value": {"content": "balance", "rawMeta": {"type": 1}, "type": "literal"}}}, {"name": "temperature", "input": {"type": "float", "value": {"content": "1", "rawMeta": {"type": 4}, "type": "literal"}}}, {"name": "maxTokens", "input": {"type": "integer", "value": {"content": "4096", "rawMeta": {"type": 2}, "type": "literal"}}}, {"name": "responseFormat", "input": {"type": "integer", "value": {"content": "0", "rawMeta": {"type": 2}, "type": "literal"}}}, {"name": "prompt", "input": {"type": "string", "value": {"content": "用户问题：{{query}}\n\n网页搜索结果：\n{{web}}\n\n本地热度表：\n{{local}}", "rawMeta": {"type": 1}, "type": "literal"}}}, {"name": "enableChatHistory", "input": {"type": "boolean", "value": {"content": false, "rawMeta": {"type": 3}, "type": "literal"}}}, {"name": "chatHistoryRound", "input": {"type": "integer", "value": {"content": "3", "rawMeta": {"type": 2}, "type": "literal"}}}, {"name": "systemPrompt", "input": {"type": "string", "value": {"content": "你是深圳餐饮推荐助手的榜单模块。用户在问热门店、网红店、必吃榜、排行榜一类的问题。\n\n输入有三部分：\n- 用户问题\n- 网页搜索结果：每条有标题、站点、日期、摘要、链接。里面混着无关内容（招租广告、商场介绍、转载到无关网站的新闻），先判断哪些和问题有关\n- 本地热度表：我们抓的小红书笔记里被提到最多的店，带商圈、评分、人均、笔记数。只覆盖南山的海岸城（后海）、深圳湾万象城、科技园一带\n\n写法：\n- 列 3 到 6 家店，每家一行：店名、上榜依据、人均或评分（输入里有才写）。\n- 店名和上榜依据只能来自输入。依据来自网页的，写站点和日期，例如\"（网易 2025-12）\"；来自本地热度表的，写\"小红书笔记 N 篇\"。\n- 网页里有正式榜单（大众点评必吃榜、美团或抖音心动榜、黑珍珠等）的，优先写，并写明哪个榜、哪一年。\n- 本地热度表里只用用户问的那个商圈的店，按地址判断（地址里写着商场名或街道）；地址看不出在不在的不用；问的商圈不在这三个里，就不用本地热度表。\n- 网页结果都不相关时，直说没搜到可靠的榜单，只给本地热度表（问的商圈在表里时）；都没有就请用户换个说法或换个商圈。\n- 搜索摘要里没写店名的（比如\"深圳首店，排名第 1\"但没说是哪家），不要猜店名。\n- 最后一行写\"来源：\"，列出实际用到的链接，最多 3 个。\n- 全文不超过 300 字，用 markdown 列表。\n", "rawMeta": {"type": 1}, "type": "literal"}}}], "settingOnError": {"processType": 1, "retryTimes": 0, "timeoutMs": 180000}}, "outputs": [{"name": "output", "type": "string", "required": false}]}}, {"id": "900001", "type": "2", "meta": {"position": {"x": 3000, "y": 0}}, "data": {"nodeMeta": {"ti